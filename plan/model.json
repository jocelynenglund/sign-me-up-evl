  "comments": [
    {
      "id": "c-1",
      "sliceId": "sign-up",
      "author": "ai",
      "text": "When the sheet is full, signing up puts you on the waitlist instead of refusing you, so one button does both. Would you rather people choose to join the waitlist?",
      "at": "2026-11-04 06:10"
    },
    {
      "id": "c-2",
      "sliceId": "cancel-sign-up",
      "author": "ai",
      "text": "When someone with a spot cancels, the first person waiting moves up straight away, with no 'do you still want it?' step. OK for a first version?",
      "at": "2026-11-04 06:10"
    },
    {
      "id": "c-3",
      "sliceId": "sign-up",
      "author": "ai",
      "text": "A person is one name on one device for now: no accounts or logins. Sign-ups only live in this browser too, so two people can't race for the last spot yet. Sharing a sheet with others (and that race) is round 2.",
      "at": "2026-11-04 06:10"
    },
    {
      "id": "c-4",
      "sliceId": "create-sheet",
      "author": "ai",
      "text": "No closing time and no editing a sheet in this round, to keep it small. Ask for them if you want them now.",
      "at": "2026-11-04 06:10"
    },
    {
      "id": "c-5",
      "author": "ai",
      "text": "EVL build: same plan as sign-me-up-eve, built as vertical slices over a table store (rows, not events). Refine in sign-me-up-eve's book; this copy is synced from it before building.",
      "at": "2026-11-04 06:10"
    }
  ]
